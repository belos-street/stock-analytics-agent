# ── LLM 配置 ─────────────────────────────────────────────────
# 复制本文件为 .env 后填写真实值：cp .env.example .env
# ⚠️ .env 含密钥，已被 .gitignore 忽略，请勿提交真实 key

# API Key（必填）
OPENAI_API_KEY=sk-your-api-key-here

# API 端点（OpenAI 兼容接口，DeepSeek / MoonShot / 月之暗面等均可填在此）
OPENAI_BASE_URL=https://api.deepseek.com

# 默认模型（必填，模型名因供应商而异，不做默认兜底）
DEFAULT_MODEL=deepseek-flash

# 是否自动补 /v1 后缀（默认 true）。
# Azure OpenAI / 路径路由型网关需保留原始 URL，设为 false 关闭。
# OPENAI_APPEND_V1=false

# ── 搜索配置（可选）────────────────────────────────────────────
# web_search 走搜索引擎 / 抓取 API，不用 LLM 的聊天补全接口。
# provider：deepseek（推荐，复用 OPENAI_API_KEY，$0.75/千次）/ tavily / serper
# bing 接口已退役，仅保留兼容
# 不填则默认 tavily；无对应 key 时 web_search 返回 SEARCH_NOT_CONFIGURED
# SEARCH_PROVIDER=deepseek
# SEARCH_API_KEY=tvly-your-key-here       # 仅 tavily / serper 需要；deepseek 默认复用 OPENAI_API_KEY
# SEARCH_BASE_URL=https://api.deepseek.com # 可选，仅 deepseek provider
