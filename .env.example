# ── LLM 配置 ─────────────────────────────────────────────────
# 复制本文件为 .env 后填写真实值：cp .env.example .env
# ⚠️ .env 含密钥，已被 .gitignore 忽略，请勿提交真实 key

# API Key（必填）
OPENAI_API_KEY=sk-your-api-key-here

# API 端点（OpenAI 兼容接口，DeepSeek / MoonShot / 月之暗面等均可填在此）
OPENAI_BASE_URL=https://api.deepseek.com

# 默认模型
DEFAULT_MODEL=deepseek-v4-flash
